              "raw": "{\n  \"deviceId\": \"device-001\",\n  \"metric\": \"temperature\",\n  \"value\": 81,\n  \"unit\": \"celsius\",\n  \"timestamp\": \"2024-01-01T12:00:00Z\"\n}"
