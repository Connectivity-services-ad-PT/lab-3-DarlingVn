        {
          "name": "GET -readings-latest - limit above max is rejected",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/readings/latest?limit=1000",
              "host": ["{{baseUrl}}"],
              "path": ["readings", "latest"],
              "query": [
                {
                  "key": "limit",
                  "value": "1000"
                }
              ]
