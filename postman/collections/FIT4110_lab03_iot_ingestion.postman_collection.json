              "raw": "{\n  \"deviceId\": \"device-001\",\n  \"metric\": \"temperature\",\n  \"value\": 80,\n  \"unit\": \"celsius\",\n  \"timestamp\": \"2024-01-01T12:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/readings",
              "host": ["{{baseUrl}}"],
              "path": ["readings"]
